# Dependencies and package-manager logs.
# package-lock.json stays tracked.
node_modules/
.npm/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Environment files and local secrets.
.env
.env.*
!.env.example
*.pem
*.p12
secrets.json
.secret

# Solana keypair files (JSON byte arrays): authority.json, mint.json, wallet.json.
keys/

# TypeScript / Node build output. There is no tsconfig; tsx runs the sources directly.
dist/
build/
*.tsbuildinfo
*.log

# Solana / Anchor build output, if an Anchor program is added later.
# src/ and scripts/ stay tracked.
.anchor/
target/
test-ledger/

# Editor and OS junk.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
