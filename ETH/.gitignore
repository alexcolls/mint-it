# Dependencies and package-manager logs.
# package-lock.json stays tracked.
node_modules/
.npm/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files and local secrets.
.env
.env.*
!.env.example
*.pem
*.p12
secrets.json
.secret

# Generated by scripts/create-keys.js (address, privateKey, mnemonic; mode 0600).
keys/

# Local Hardhat deployment record and research dumps.
deployments/
scratch/

# Hardhat compiler and test output.
artifacts/
cache/
typechain/
typechain-types/
coverage/
coverage.json

# Foundry build output, if Foundry is added later.
# lib/ holds project source (common.js, bytecode.js) and stays tracked.
out/
broadcast/

# Editor and OS junk.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log
*.tsbuildinfo
dist/
build/
