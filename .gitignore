# Dependencies and package-manager logs.
# Lockfiles (package-lock.json) stay tracked.
node_modules/
.npm/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Environment files and local secrets.
.env
.env.*
!.env.example
*.pem
*.p12
secrets.json
.secret

# Keypairs and deployment records. ETH and SOL both keep secrets under keys/.
keys/
deployments/
scratch/

# Node / TypeScript build output.
dist/
build/
*.tsbuildinfo
*.log

# Hardhat (ETH/).
artifacts/
cache/
typechain/
typechain-types/
coverage/
coverage.json

# Foundry build output, if a Foundry package is added later.
# lib/ is project source in ETH and stays tracked.
out/
broadcast/

# Solana / Anchor build output, if an Anchor package is added later.
# src/ stays tracked.
.anchor/
target/
test-ledger/

# Editor and OS junk.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
